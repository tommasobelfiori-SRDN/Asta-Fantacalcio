{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.@(js|css|svg|png|woff2)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ],
    "rewrites": [
      {
        "source": "/api/quotazioni",
        "function": { "functionId": "quotazioni", "region": "europe-west1" }
      },
      {
        "source": "/api/dettagli-giocatore",
        "function": { "functionId": "dettagliGiocatore", "region": "europe-west1" }
      },
      {
        "source": "/api/probabili",
        "function": { "functionId": "probabili", "region": "europe-west1" }
      },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "functions": {
    "source": "functions",
    "ignore": ["node_modules", ".git", "*.log"]
  },
  "emulators": {
    "functions": { "port": 5001 },
    "hosting": { "port": 5002 },
    "ui": { "enabled": true }
  }
}
