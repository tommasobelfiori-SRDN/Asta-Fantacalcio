# Questa Cloud Function non richiede alcun secret: legge solo una pagina pubblica
# di fantacalcio.it, senza chiavi API né credenziali.

# Soglia minima di calciatori attesi nella pagina quotazioni: sotto questo numero
# la function considera la risposta sospetta (probabile cambio di struttura del
# sito) e restituisce un errore invece di dati incompleti. Facoltativa (default 400).
# MIN_EXPECTED_ROWS=400

# Soglia minima di squadre attese nella pagina rigoristi (oggi 20 in Serie A): sotto
# questo numero i dati sui rigoristi vengono ignorati (le quotazioni restano comunque
# disponibili). Facoltativa (default 15).
# MIN_EXPECTED_TEAMS=15

# Soglia minima di righe attese nella pagina statistiche dell'ultima stagione
# conclusa (a fine campionato sono ~660): sotto questo numero i dati storici
# vengono ignorati e le quotazioni restano comunque disponibili. Facoltativa (default 400).
# MIN_EXPECTED_STATS_ROWS=400
